# Port the site listens on
PORT=3000

# Password for /admin (any username works)
ADMIN_PASSWORD=change-me

# SQLite database location (defaults to ./data/registrations.db)
# DATABASE_FILE=/var/lib/union-reg/registrations.db

# Cvent integration
#   off = no API calls; people are sent to the event's Cvent registration URL and you confirm in /admin
#   api = create the attendee in Cvent via the REST API and confirm payment automatically
CVENT_MODE=off
CVENT_REGION=na            # na or eu
CVENT_CLIENT_ID=
CVENT_CLIENT_SECRET=
# Space-separated OAuth scopes your Cvent API app was granted, if Cvent requires them in the token request
# CVENT_SCOPE=event/attendees:read event/attendees:write event/contacts:write

# How often (minutes) to pull attendee status from Cvent and release expired holds
SYNC_INTERVAL_MINUTES=2

# Secret path segment for the Cvent webhook: https://your-site/webhooks/cvent/<WEBHOOK_SECRET>
WEBHOOK_SECRET=
